# Copy to .env and fill in. Never commit .env.

# PostgreSQL. Docker Compose builds DATABASE_URL from POSTGRES_PASSWORD; set
# DATABASE_URL yourself only when running the backend outside Compose.
POSTGRES_PASSWORD=change-me
# DATABASE_URL=postgresql://lookout:change-me@localhost:5432/lookout

# Signs session tokens (HS256). 32+ random characters, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Seeds the ML-DSA-65 audit-signing key so signatures verify across restarts.
POST_QUANTUM_KEY=

# Where the trained classifier lives (defaults to backend/trained_models/).
# MODEL_PATH=

# Allowed browser origin for the API.
FRONTEND_URL=http://localhost:3000

# Optional: Gemini writes incident narratives; without it a template does.
GEMINI_API_KEY=

# Where critical alerts are sent. All optional; with none set, notifications
# are off. A chat webhook (Slack, Discord, Google Chat, Teams) or a Telegram
# bot URL plus ALERT_TELEGRAM_CHAT_ID.
ALERT_WEBHOOK_URL=
ALERT_TELEGRAM_CHAT_ID=
# Email alerts go through Brevo's HTTP API (Render's free tier blocks SMTP).
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
BREVO_API_KEY=
# HIGH or CRITICAL (default), and the flood limits.
ALERT_MIN_SEVERITY=CRITICAL
ALERT_MAX_PER_HOUR=20
ALERT_COOLDOWN_SECONDS=300

# Port the site is published on.
LOOKOUT_PORT=3000

# Demo switches.
LOOKOUT_LIVE_TRAFFIC=1
LOOKOUT_ALLOW_TAMPER=1
