# Copy to .env and fill in. Never commit .env.

# PostgreSQL. Docker Compose builds DATABASE_URL from POSTGRES_PASSWORD; set
# DATABASE_URL yourself only when running the backend outside Compose.
POSTGRES_PASSWORD=change-me
# DATABASE_URL=postgresql://lookout:change-me@localhost:5432/lookout

# Signs session tokens (HS256). 32+ random characters, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Seeds the ML-DSA-65 audit-signing key so signatures verify across restarts.
POST_QUANTUM_KEY=

# Where the trained classifier lives (defaults to backend/trained_models/).
# MODEL_PATH=

# Allowed browser origin for the API.
FRONTEND_URL=http://localhost:3000

# Optional: Gemini writes incident narratives; without it a template does.
GEMINI_API_KEY=

# Port the site is published on.
LOOKOUT_PORT=3000

# Demo switches.
LOOKOUT_LIVE_TRAFFIC=1
LOOKOUT_ALLOW_TAMPER=1
