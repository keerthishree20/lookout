# All optional. Lookout runs fully offline with none of these set.

# Gemini writes the incident narrative. Without it, a deterministic template
# built from the same evidence is used. The LLM never affects the score.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 32-byte seed for the ML-DSA audit key, so the verification key is stable
# across restarts. The default is a demo value -- change it for anything real.
LOOKOUT_AUDIT_SEED=

# Background stream of ordinary staff activity for the console.
LOOKOUT_LIVE_TRAFFIC=1
LOOKOUT_TRAFFIC_INTERVAL=1.5

# Set to 0 to disable the audit-forgery demo endpoint.
LOOKOUT_ALLOW_TAMPER=1

# Extra allowed browser origins, comma-separated (localhost is always allowed).
CORS_ORIGINS=
